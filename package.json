{
    "name": "keil-assistant-optimized",
    "displayName": "Keil 助手（优化版）",
    "description": "在 VS Code 中管理和编译 Keil uVision 工程",
    "version": "1.7.11",
    "publisher": "qqzxc276869-bot",
    "author": {
        "name": "Goal",
        "url": "https://github.com/qqzxc276869-bot"
    },
    "keywords": [
        "keil",
        "mdk",
        "c51",
        "8051",
        "stm32"
    ],
    "homepage": "https://github.com/qqzxc276869-bot/keil-assistant-optimized",
    "engines": {
        "vscode": "^1.41.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "activationEvents": [
        "onView:project",
        "onLanguage:a51",
        "workspaceContains:**/*.uvproj",
        "workspaceContains:**/*.uvprojx",
        "workspaceContains:**/*.UVPROJ",
        "workspaceContains:**/*.UVPROJX",
        "onCommand:explorer.open",
        "onCommand:explorer.discover",
        "onCommand:project.addFile",
        "onCommand:project.createGroup",
        "onCommand:project.addFileToGroup",
        "onCommand:project.removeFile",
        "onCommand:project.forgetAutoAddFolder",
        "onCommand:project.switch",
        "onCommand:project.active",
        "onCommand:project.close",
        "onCommand:project.build",
        "onCommand:project.rebuild",
        "onCommand:project.download",
        "onCommand:item.copyValue"
    ],
    "icon": "res/icons/icon.png",
    "main": "./dist/src/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/qqzxc276869-bot/keil-assistant-optimized.git"
    },
    "bugs": {
        "url": "https://github.com/qqzxc276869-bot/keil-assistant-optimized/issues"
    },
    "contributes": {
        "configuration": [
            {
                "title": "Keil 助手",
                "properties": {
                    "KeilAssistant.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "Keil C51 的 `UV4.exe` 完整路径。",
                        "default": "null"
                    },
                    "KeilAssistant.MDK.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "Keil MDK 的 `UV4.exe` 完整路径。",
                        "default": "null"
                    },
                    "KeilAssistant.Project.ExcludeList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "查找工程时排除的 uVision 工程文件名或相对于工作区的路径。",
                        "default": []
                    },
                    "KeilAssistant.Project.FileLocationList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "要额外加载的 uVision 工程路径，可使用绝对路径或相对于第一个工作区文件夹的路径。",
                        "default": []
                    },
                    "KeilAssistant.Project.AutoAddNewFiles": {
                        "type": "boolean",
                        "scope": "resource",
                        "markdownDescription": "在 VS Code 中新建受支持的文件并首次保存后，自动将其加入 Keil 工程。文件夹对应多个分组时，选择一次后会记住。",
                        "default": true
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "explorer.open",
                "title": "打开 Keil 工程",
                "icon": {
                    "light": "./res/icons/ClassAdded_16x.svg",
                    "dark": "./res/icons/ClassAdded_16x.svg"
                }
            },
            {
                "command": "explorer.discover",
                "title": "查找工作区中的 Keil 工程",
                "icon": {
                    "light": "./res/icons/refresh-light.svg",
                    "dark": "./res/icons/refresh-dark.svg"
                }
            },
            {
                "command": "project.addFile",
                "title": "将文件添加到 Keil 工程"
            },
            {
                "command": "project.createGroup",
                "title": "新建 Keil 分组"
            },
            {
                "command": "project.addFileToGroup",
                "title": "将文件添加到 Keil 分组"
            },
            {
                "command": "project.removeFile",
                "title": "从 Keil 工程移除文件引用"
            },
            {
                "command": "project.forgetAutoAddFolder",
                "title": "清除自动添加的文件夹分组记录"
            },
            {
                "command": "project.switch",
                "title": "切换编译目标",
                "icon": {
                    "light": "./res/icons/SwitchSourceOrTarget_16x.svg",
                    "dark": "./res/icons/SwitchSourceOrTarget_16x.svg"
                }
            },
            {
                "command": "project.active",
                "title": "设为当前工程"
            },
            {
                "command": "project.close",
                "title": "关闭工程",
                "icon": {
                    "light": "./res/icons/StatusOffline_16x.svg",
                    "dark": "./res/icons/StatusOffline_16x.svg"
                }
            },
            {
                "command": "project.build",
                "title": "编译",
                "icon": {
                    "light": "./res/icons/BuildSelection_16x.svg",
                    "dark": "./res/icons/BuildSelection_16x.svg"
                }
            },
            {
                "command": "project.rebuild",
                "title": "重新编译",
                "icon": {
                    "light": "./res/icons/BuildSolution_16x.svg",
                    "dark": "./res/icons/BuildSolution_16x.svg"
                }
            },
            {
                "command": "project.download",
                "title": "下载到设备",
                "icon": {
                    "light": "./res/icons/TransferDownload_16x.svg",
                    "dark": "./res/icons/TransferDownload_16x.svg"
                }
            },
            {
                "command": "item.copyValue",
                "title": "复制条目内容",
                "icon": {
                    "light": "./res/icons/CopyToClipboard_16x.svg",
                    "dark": "./res/icons/CopyToClipboard_16x.svg"
                }
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "item.copyValue",
                    "when": "false"
                }
            ],
            "explorer/context": [
                {
                    "command": "project.addFile",
                    "when": "resourceExtname =~ /\\.(c|s|asm|a51|a66|lib|h|hpp|hxx|hh|inc|cpp|cc|cxx|c\\+\\+)$/i",
                    "group": "navigation@10"
                }
            ],
            "editor/context": [
                {
                    "command": "project.addFile",
                    "when": "resourceExtname =~ /\\.(c|s|asm|a51|a66|lib|h|hpp|hxx|hh|inc|cpp|cc|cxx|c\\+\\+)$/i",
                    "group": "navigation@10"
                }
            ],
            "view/title": [
                {
                    "command": "explorer.open",
                    "group": "navigation",
                    "when": "view == project"
                },
                {
                    "command": "explorer.discover",
                    "group": "navigation",
                    "when": "view == project"
                },
                {
                    "command": "project.forgetAutoAddFolder",
                    "group": "1_keil@1",
                    "when": "view == project"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.createGroup",
                    "when": "viewItem == Project || viewItem == Target"
                },
                {
                    "command": "project.addFileToGroup",
                    "when": "viewItem == FileGroup"
                },
                {
                    "command": "project.removeFile",
                    "when": "viewItem == ProjectSource"
                },
                {
                    "command": "project.close",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.active",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.switch",
                    "group": "inline",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source || viewItem == ProjectSource"
                }
            ]
        },
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            },
            {
                "command": "project.download",
                "key": "ctrl+alt+d"
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 汇编",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "project",
                    "name": "Keil uVision 工程"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "keil-task"
            }
        ],
        "problemMatchers": [
            {
                "name": "c51",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning)\\s+([A-Z0-9]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "armcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "gcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run check && npm run build",
        "build": "node scripts/build.js",
        "check": "node scripts/check.js",
        "pretest": "npm run build",
        "test": "node scripts/smoke.js && node scripts/test_cpp_config.js"
    },
    "devDependencies": {
        "@types/node": "^12.11.7",
        "@types/vscode": "1.41.0",
        "@types/xml2js": "^0.4.5",
        "typescript": "^3.6.4"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "xml2js": "^0.6.2"
    }
}
